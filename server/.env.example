SMTP_PORT=2525
API_PORT=8025
DATA_DIR=./data
QUARANTINE_TTL_HOURS=168
SWEEPER_INTERVAL_SEC=60
LOG_LEVEL=info

# Outbound delivery
SEND_MODE=loopback                  # loopback | relay
DKIM_SELECTOR=zs1

# Relay (only used when SEND_MODE=relay)
RELAY_HOST=
RELAY_PORT=587
RELAY_USER=
RELAY_PASS=
RELAY_SECURE=false                  # true for implicit-TLS (port 465)

# Outlook inbound pipeline (slice 2). Azure app registration (authority: common).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Alias forwarding & abuse limits (defaults shown)
ALIAS_MAX_PER_ACCOUNT=50
FORWARD_TARGETS_MAX_PER_ACCOUNT=5
ALIAS_FORWARD_MAX_PER_HOUR=200
ALIAS_REPLY_MAX_PER_HOUR=50
# Local dev has no real DNS, so DMARC is always inconclusive; keep true in production.
ALIAS_REPLY_REQUIRE_DMARC=false
FORWARD_VERIFY_EXPIRY_HOURS=24

# Stripe billing (docs/superpowers/specs/2026-10-12-stripe-billing-design.md).
# Ships OFF: while false, nobody is billed and no trial clock runs.
BILLING_ENABLED=false
BILLING_TRIAL_MONTHS=3
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Mobile push notifications through Expo (docs/android-app-spec.md §4.1). Off by default.
PUSH_ENABLED=false
# Only if "Enhanced push security" is enabled in the Expo project.
EXPO_ACCESS_TOKEN=
