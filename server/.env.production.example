# ---- ZeroSpam production env (values injected from SSM at boot; see scripts/entrypoint.sh) ----
NODE_ENV=production
API_PORT=8025
SMTP_PORT=25
DATA_DIR=/data
WEB_DIST_PATH=/app/web/dist

PUBLIC_BASE_URL=https://zero-spam.email
ALLOWED_ORIGINS=https://zero-spam.email
SIGNUP_DOMAIN=zero-spam.email

# Reverse-proxy trust. The app runs behind Caddy over the docker network, so it
# sees Caddy's container IP, not the client. Set this so req.ip is derived from
# X-Forwarded-For. Trust loopback + private ranges: Caddy's container IP is on the
# Docker bridge network and the API port is not published, so only Caddy can reach
# it. REQUIRED in this topology — without it, rate-limiting and audit logs attribute
# every request to Caddy's IP. (Hop counts like "1" are no longer honored by Fastify.)
TRUST_PROXY=loopback,uniquelocal

# Session lifetimes in days. Optional — these are the built-in defaults. Idle is a
# sliding window refreshed on activity; absolute is a hard cap from login.
SESSION_IDLE_TTL_DAYS=30
SESSION_ABSOLUTE_TTL_DAYS=90

# Inbound STARTTLS — leave BLANK initially so the app boots plaintext (still accepts
# mail). buildSmtpTlsOptions() throws if these are set but the files are missing, which
# would crash startup. Enable STARTTLS only after confirming Caddy's issued cert path,
# which is nested, e.g.:
#   /certs/caddy/certificates/acme-v02.api.letsencrypt.org-directory/zero-spam.email/zero-spam.email.crt
# See docs/deploy-runbook.md Phase 4.
TLS_CERT_PATH=
TLS_KEY_PATH=

# Outbound via Amazon SES SMTP relay
SEND_MODE=relay
RELAY_HOST=email-smtp.us-east-1.amazonaws.com
RELAY_PORT=587
RELAY_SECURE=false
RELAY_USER=__SES_SMTP_USERNAME__
RELAY_PASS=__SES_SMTP_PASSWORD__

# Secrets (SecureString in SSM; never commit real values)
SESSION_SECRET=__32_PLUS_RANDOM__
CONNECTION_SECRET=__32_PLUS_RANDOM__
DIGEST_SIGNING_SECRET=__32_PLUS_RANDOM__

# OAuth (optional; only if Gmail/Outlook connect is used)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Alias forwarding & abuse limits (defaults shown)
ALIAS_MAX_PER_ACCOUNT=50
FORWARD_TARGETS_MAX_PER_ACCOUNT=5
ALIAS_FORWARD_MAX_PER_HOUR=200
ALIAS_REPLY_MAX_PER_HOUR=50
ALIAS_REPLY_REQUIRE_DMARC=true
FORWARD_VERIFY_EXPIRY_HOURS=24

# Stripe billing (docs/superpowers/specs/2026-10-12-stripe-billing-design.md).
# Ships OFF: while false, nobody is billed and no trial clock runs.
BILLING_ENABLED=false
BILLING_TRIAL_MONTHS=3
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Mobile push notifications through Expo (docs/android-app-spec.md §4.1). Off by default.
PUSH_ENABLED=false
# Only if "Enhanced push security" is enabled in the Expo project.
EXPO_ACCESS_TOKEN=
