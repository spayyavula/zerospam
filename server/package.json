{
  "name": "@zerospam/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "seed:test-users": "tsx --env-file-if-exists=.env src/seed-test-users.ts",
    "inject": "tsx --env-file-if-exists=.env src/inject.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@azure/msal-node": "^5.2.3",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.1.2",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "argon2": "^0.41.1",
    "fastify": "^5.12.5",
    "googleapis": "^173.0.0",
    "mailauth": "^7.3.0",
    "mailparser": "^3.9.38",
    "nanoid": "^5.1.16",
    "nodemailer": "^10.1.0",
    "otplib": "^12.0.1",
    "smtp-server": "^3.19.21",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/smtp-server": "^3.5.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  }
}
